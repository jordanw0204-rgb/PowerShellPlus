<Window x:Class="PowerShellPlus.Native.AgentNotificationToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="430" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False">
  <Grid x:Name="ToastRoot" Opacity="0" RenderTransformOrigin="0.5,0">
    <Grid.RenderTransform><TranslateTransform x:Name="ToastTranslate" Y="-24"/></Grid.RenderTransform>
    <Border x:Name="ToastCard" Margin="14" Padding="14,12" CornerRadius="14"
            Background="#F2181825" BorderBrush="#7045475A" BorderThickness="1"
            MouseLeftButtonUp="ToastCardMouseLeftButtonUp" Cursor="Hand">
      <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="7" Opacity="0.48" Color="#000000"/></Border.Effect>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border x:Name="AccentBar" CornerRadius="3" Margin="0,1,0,1"/>
        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="12" Margin="11,1,12,0"
                Background="#25253A" BorderBrush="#45475A" BorderThickness="1">
          <Grid>
            <Ellipse x:Name="StatusHalo" Width="23" Height="23" Opacity="0.16"/>
            <TextBlock Text="✦" x:Name="StatusGlyph" FontFamily="Segoe UI Symbol" FontSize="17" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <StackPanel Grid.Column="2" Margin="0,0,10,0">
          <TextBlock x:Name="TitleText" Foreground="#CDD6F4" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="MessageText" Foreground="#A6ADC8" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
          <Border HorizontalAlignment="Left" Background="#25253A" CornerRadius="7" Padding="7,2" Margin="0,7,0,0">
            <TextBlock x:Name="TerminalText" Foreground="#BAC2DE" FontSize="9.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxWidth="270"/>
          </Border>
        </StackPanel>
        <Button Grid.Column="3" Width="25" Height="25" Padding="0" Margin="2,-3,-4,0" VerticalAlignment="Top"
                Background="Transparent" BorderBrush="Transparent" Foreground="#7F849C" FontSize="15"
                Content="×" Click="CloseClick" Cursor="Hand" ToolTip="Dismiss"/>
        <Border Grid.ColumnSpan="4" Height="2" VerticalAlignment="Bottom" Margin="0,58,0,-12" CornerRadius="1" Background="#25253A">
          <Border x:Name="ProgressBar" HorizontalAlignment="Left" Width="398" CornerRadius="1" RenderTransformOrigin="0,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="ProgressScale" ScaleX="1"/></Border.RenderTransform>
          </Border>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
